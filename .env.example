# Database (app connects to the postgres service inside Docker)
DB_HOST=postgres
DB_PORT=5432
DB_USER=telegramrag
DB_PASSWORD=change_me
DB_NAME=telegramrag

# RAG
EMBEDDING_MODEL=sentence-transformers/clip-ViT-B-32-multilingual-v1
EMBEDDING_N_DIM=512
RAG_STRATEGY=naive
TOP_K=5

 # LLM provider: openai | google | openai_compatible (Ollama, LM Studio, MLX server, ...) | openrouter
LLM_PROVIDER=openai_compatible
LLM_MODEL=ollama/gemma4
# Required when LLM_PROVIDER=openai_compatible (Ollama/LM Studio/MLX base URL)
LLM_BASE_URL=http://ollama:11434/v1
# Required when LLM_PROVIDER=openai, LLM_PROVIDER=google, or LLM_PROVIDER=openrouter
LLM_API_KEY=
 # When LLM_PROVIDER=openrouter, LLM_MODEL uses OpenRouter's provider/model naming, e.g. openai/gpt-4o-mini

# Embedding provider: sentence_transformers | openai | google | openrouter
EMBEDDING_PROVIDER=sentence_transformers
# Required when EMBEDDING_PROVIDER=openai, EMBEDDING_PROVIDER=google, or EMBEDDING_PROVIDER=openrouter
EMBEDDING_API_KEY=
# Before switching EMBEDDING_PROVIDER/EMBEDDING_MODEL/EMBEDDING_N_DIM on an existing DB,
# run `uv run python scripts/clear_embeddings.py` first — it deletes all stored posts
# (embedding is NOT NULL, so old-dimension vectors can't just be nulled out).
# Re-import channels/posts afterwards to repopulate with the new provider's embeddings.

# Telegram
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
TELEGRAM_SESSION_NAME=telegramrag

# Docker / runtime (used by docker-compose and the app container CMD)
APP_PORT=8000